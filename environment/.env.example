# VEGA environment configuration
# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# --- Google Gemini ---
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL_NAME=
OPENAI_FALLBACK_MODEL=

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_FALLBACK_MODEL=llama3.2:1b

# --- Groq ---
GROQ_API_KEY=

# --- Voice (Microsoft Edge TTS) ---
EDGE_TTS_VOICE=pt-BR-FranciscaNeural

# --- MySQL (opcional; usado pela migracao em database/) ---
VEGA_DB_HOST=127.0.0.1
VEGA_DB_PORT=3306
VEGA_DB_NAME=vega
VEGA_DB_USER=vega
VEGA_DB_PASSWORD=
